{
  "expo": {
    "name": "MandarClerkApp",
    "slug": "MandarClerkApp",
    "version": "1.0.0",
    "scheme": "mandarclerkapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shikhar.mandarclerkapp"
    },
    "android": {
      "package": "com.shikhar.mandarclerkapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Allow MandarClerkApp to connect to thermal ticket printers via Bluetooth.",
          "alwaysUsageDescription": "Allow MandarClerkApp to discover logistics hardware components.",
          "protocols": [
            "com.datecs.linea.pro",
            "com.bxl.protocol"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35cc6d47-5bc6-4b36-a11c-b5b7d13fd57e"
      }
    }
  }
}
